{
  "train_jsonl": "${TRAIN_JSONL}",
  "val_jsonl": "${VAL_JSONL}",
  "output_dir": "${NOFLOW_RUN}",
  "qwen_model_path": "${QWEN_MODEL_PATH}",
  "qwen_cache_dir": null,
  "visual_cache_root": "${VISUAL_CACHE_ROOT}",
  "extra_visual_cache_root": [
    "${EXTRA_VISUAL_CACHE_ROOT}"
  ],
  "scannet_frame_root": "${SCANNET_FRAME_ROOT}",
  "max_train_rows": 0,
  "max_val_rows": 512,
  "require_patch_geometry": true,
  "epochs": 1,
  "batch_size": 1,
  "gradient_accumulation_steps": 8,
  "num_workers": 0,
  "device": "cuda",
  "seed": 0,
  "max_visual_frames": 32,
  "max_pixels": 50176,
  "depth_grid_h": 24,
  "depth_grid_w": 32,
  "reference_schema": "simple3",
  "simple3_aux_required": true,
  "flow_dim": 512,
  "num_flow_steps": 4,
  "disable_spatial_flow_bias": true,
  "dropout": 0.05,
  "bev_grid_size": 32,
  "lr": 3e-05,
  "weight_decay": 0.0001,
  "grad_clip": 1.0,
  "gradient_checkpointing": false,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj",
  "reference_type_loss_weight": 0.2,
  "query_pose_loss_weight": 0.1,
  "bev_loss_weight": 0.05,
  "patch_consistency_loss_weight": 0.05,
  "target_camera_coord_loss_weight": 0.0,
  "semantic_query_coord_loss_weight": 0.0,
  "bev_coord_loss_weight": 0.0,
  "object_center_loss_weight": 0.0,
  "log_every": 10,
  "eval_every_steps": 512,
  "eval_max_batches": 64,
  "save_every_steps": 512,
  "save_optimizer_state": true
}
